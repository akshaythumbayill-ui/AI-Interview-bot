# ── LLM Provider ──────────────────────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
# Development placeholder only; production requires a unique secret of 32+ characters.
SECRET_KEY=change_me_in_production

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./interview_coach.db

# ── FAISS / Embeddings ────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_DIR=./faiss_indexes

# ── Interview Defaults ────────────────────────────────────────────────────────
DEFAULT_NUM_QUESTIONS=10
MAX_QUESTIONS=15

# ── Optional TTS (leave blank to use browser speechSynthesis) ─────────────────
# ELEVENLABS_API_KEY=
# EDGE_TTS_VOICE=en-US-JennyNeural

# ── Optional Whisper via Groq (leave blank to use browser Web Speech API) ─────
# WHISPER_MODEL=whisper-large-v3
